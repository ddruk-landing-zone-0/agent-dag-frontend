FROM ubuntu:latest

# Install curl and Node.js (LTS)
RUN apt-get update && \
    apt-get install -y curl && \
    curl -fsSL https://deb.nodesource.com/setup_lts.x | bash - && \
    apt-get install -y nodejs && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Set default workdir
WORKDIR /app

# Default command
CMD ["node", "--version"]
